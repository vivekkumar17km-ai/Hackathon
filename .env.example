# SourceMark Backend — Environment Variables
# Copy this file to .env and adjust values as needed.
# Never commit a .env file with real secrets to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to the Hackathon/ working directory)
DATABASE_PATH=./sourcemark.db

# ─── File Upload Limits ───────────────────────────────────────────────────────
# Maximum size in megabytes for files uploaded to /api/compare
MAX_UPLOAD_SIZE_MB=50

# ─── CORS Origins ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ─── Runtime Environment ──────────────────────────────────────────────────────
ENVIRONMENT=development

# ─── Authentication & Security ────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-random-secure-64-character-hex-key
JWT_EXPIRE_MINUTES=480
UPLOAD_DIR=./uploads


